# 复制到服务器私有目录的env文件中填写；真实值不能提交Git。
# POSTGRES_PASSWORD仅用于新数据卷初始化；修改此变量不会轮换已有数据库密码。
POSTGRES_PASSWORD=
# 八个连接须指向同一部署内对应业务库；密码含特殊字符时在URL中进行百分号编码。
# URL形式：postgres://postgres:<URL编码密码>@postgres:5432/applicant（其余库替换末尾名称）
APPLICANT_DATABASE_URL=
GATHERER_DATABASE_URL=
INVESTIGATOR_DATABASE_URL=
ASSESSOR_DATABASE_URL=
MANAGER_DATABASE_URL=
DESIGNER_DATABASE_URL=
SCHOLAR_DATABASE_URL=
ASSISTANT_DATABASE_URL=
GATEWAY_TOKEN=
# P06 用户登录：格式 用户名:scrypt哈希[:admin]，多用户逗号分隔；哈希用 node -e "const c=require('crypto');c.scrypt('口令','盐',32,(e,d)=>console.log('scrypt$盐$'+d.toString('hex')))" 生成
GATEWAY_USERS=
# 会话签名密钥（GATEWAY_USERS 非空时必填）
GATEWAY_SESSION_SECRET=
# 用户可访问应用：用户名:app1,app2；多用户分号分隔；未配置默认全部应用
GATEWAY_USER_APPS=
# 服务间调用令牌：服务名:token，逗号分隔（如 assistant:xxx）；服务身份不受应用限制
GATEWAY_SERVICE_TOKENS=
# assistant 服务调用网关专用令牌（缺省回落 GATEWAY_TOKEN）
GATEWAY_ASSISTANT_SERVICE_TOKEN=
MANAGER_APPROVAL_TOKEN=
MANAGER_APPROVAL_ACTOR=owner
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash
LLM_PROVIDER=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_REPO=Era3e/MagicTools
GITHUB_BASE_BRANCH=main
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BOT_WEBHOOK=
CLAWCV_API_KEY=
CLAWCV_BACKEND_URL=https://api.wondercv.com
CYBERCLOUD_BASE_URL=
CYBERCLOUD_API_KEY=
CYBERCLOUD_AGENT_ID=
CYBERCLOUD_USERNAME=
CYBERCLOUD_PASSWORD=
CYBERCLOUD_JWT=
CYBERCLOUD_MODE=dual
CYBERCLOUD_DIRECT_TIMEOUT_MS=8000
CYBERCLOUD_VERIFY_TIMEOUT_MS=60000
CYBERCLOUD_COMPARE_TOLERANCE=0.01
CLARIFY_THRESHOLD=0.6
FT_LAUNCH_ENABLED=0
