# gateway 访问令牌（留空则本地不鉴权）
GATEWAY_TOKEN=
# LLM 密钥（真实值不入库）
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
# 不设置全局 DATABASE_URL：各业务服务默认连接各自数据库，避免全部误连同一库。
# Manager 门禁专用测试库（禁止使用业务库；CI 复用已有 pgvector 实例）
MANAGER_TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/mt_manager_test
# 内容审批：默认关闭。启用时注入 32–1024 位不含空格的可打印 ASCII 随机凭证。
MANAGER_APPROVAL_TOKEN=
MANAGER_APPROVAL_ACTOR=owner
# 飞书（Investigator，接入步骤见 docs/integrations/feishu-setup.md）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BOT_WEBHOOK=
FEISHU_BOT_SECRET=
# 超级简历 ClawCV（Applicant，接入步骤见 docs/integrations/clawcv-setup.md）
CLAWCV_API_KEY=
CLAWCV_BACKEND_URL=https://api.wondercv.com
# cybercloud 智能体平台（Assistant data_query，接入步骤见 docs/integrations/cybercloud-setup.md）
CYBERCLOUD_BASE_URL=
CYBERCLOUD_API_KEY=
CYBERCLOUD_AGENT_ID=
CYBERCLOUD_USERNAME=
CYBERCLOUD_PASSWORD=
# CYBERCLOUD_JWT=（可选：直接填现成 JWT 则跳过账号密码登录）
CYBERCLOUD_MODE=dual                  # agent | direct | dual（双路对比模式，默认 dual）
CYBERCLOUD_DIRECT_TIMEOUT_MS=8000     # 直连流水线整体超时
CYBERCLOUD_VERIFY_TIMEOUT_MS=60000    # 智能体核验超时
CYBERCLOUD_COMPARE_TOLERANCE=0.01     # 双路数值比对容差（1%）
# CYBERCLOUD_STUB_AGENT_ANSWER=（桩模式智能体答文案；__FAIL__ 模拟智能体故障；缺省为与直连一致的 12345）
# CYBERCLOUD_STUB_DIRECT_APPLICABLE=（桩模式直连适用性：0=强制不适用，用于测试回退路径）
