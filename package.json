{
  "name": "magictools",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:affected": "turbo run test --affected",
    "coverage": "turbo run coverage",
    "lint": "eslint .",
    "test:infra": "node infra/scripts/test-infra.mjs",
    "test:manager:integration": "pnpm --filter @mt/manager-server test:integration",
    "test:db": "node infra/scripts/test-database.mjs",
    "images:build": "node infra/scripts/build-images.mjs",
    "images:validate": "node infra/scripts/validate-runtime.mjs",
    "images:smoke": "node infra/scripts/images-smoke.mjs",
    "images:publish": "node infra/scripts/publish-images.mjs",
    "images:release": "node infra/scripts/release-images.mjs",
    "deploy:release": "node infra/scripts/deploy-release.mjs",
    "deploy:ssh": "node infra/scripts/deploy-ssh.mjs",
    "deploy:validate": "node infra/scripts/validate-deployment.mjs",
    "backup:create": "node infra/scripts/backup.mjs create",
    "backup:verify": "node infra/scripts/backup.mjs verify",
    "backup:restore": "node infra/scripts/backup.mjs restore",
    "backup:validate": "node infra/scripts/validate-backup.mjs",
    "backup:prune": "node infra/scripts/backup.mjs prune",
    "backup:ssh": "node infra/scripts/backup.mjs ssh",
    "backup:handoff": "node infra/scripts/backup.mjs handoff",
    "recovery:validate": "node infra/scripts/validate-recovery-deployment.mjs",
    "smoke": "node infra/scripts/smoke.mjs",
    "e2e": "pnpm --filter @mt/e2e exec playwright test",
    "e2e:update": "pnpm --filter @mt/e2e exec playwright test --update-snapshots",
    "e2e:visual": "pnpm --filter @mt/e2e exec playwright test _visual.spec.ts",
    "e2e:visual:update": "pnpm --filter @mt/e2e exec playwright test _visual.spec.ts --update-snapshots",
    "design:check": "node magictools-ui-design/scripts/check-design-consistency.mjs",
    "qa:gate": "node infra/scripts/quality-gate.mjs",
    "new:app": "node infra/scripts/new-app.mjs",
    "docs:lint": "markdownlint-cli2 \"docs/**/*.md\"",
    "changeset": "changeset",
    "release": "changeset version",
    "release:tag": "changeset tag",
    "ws:create": "node infra/scripts/workspace.mjs create",
    "ws:cleanup": "node infra/scripts/workspace.mjs cleanup"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@vitest/coverage-v8": "^2",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "markdownlint-cli2": "^0.14.0",
    "pg": "8.23.0",
    "turbo": "^2.1.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8",
    "vitest": "2.1.9",
    "yaml": "^2.5.0"
  }
}
