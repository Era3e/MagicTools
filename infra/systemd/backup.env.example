# Public locations only. Never place passwords, key bytes, or webhook tokens here.
# Quote paths containing spaces. Use an absolute path for every local file/directory.
MT_BACKUP_CONTAINER=magictools-postgres-1
MT_BACKUP_DIRECTORY=/var/lib/magictools/backups
MT_BACKUP_CREDENTIALS_FILE=/etc/magictools/backup/pg-credentials.json
MT_BACKUP_KEY_FILE=/etc/magictools/backup/backup.key
MT_BACKUP_CATALOG=/opt/magictools/backup-runner/infra/ports.json
MT_BACKUP_EVENTS_DIRECTORY=/var/lib/magictools/backup-events
# Optional private webhook configuration, used only by an explicit service override.
# MT_BACKUP_NOTIFY_CONFIG=/etc/magictools/backup/webhook.json
